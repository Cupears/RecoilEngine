<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.cupears.recoilclient"
    android:versionCode="3"
    android:versionName="0.3">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Recoil Android Client"
        android:debuggable="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name="org.libsdl.app.SDLActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
